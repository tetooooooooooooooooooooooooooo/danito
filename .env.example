# Copy to .env for local development. .env is gitignored; never commit real values.
# On Heroku these are config vars instead, and the real environment always wins over this file.

# ── shared by the bot and the dashboard ──────────────────────────────
BOT_TOKEN=
Database_Connection_String=

# ── dashboard only ───────────────────────────────────────────────────
# Both from the Discord Developer Portal, under OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match a redirect exactly as entered in the portal, including the scheme and port.
DISCORD_REDIRECT_URI=http://localhost:5000/callback

# Signs the session cookie. Any long random string; changing it logs everyone out.
DASHBOARD_SECRET_KEY=

# The name shown on the web pages. The bot's own name inside Discord comes from the
# application in the Developer Portal, so that one follows a rename without a deploy.
DASHBOARD_BRAND=Newt

# Session cookies are Secure-only by default, which a browser will not send over plain http.
# Set this to 1 for localhost, and leave it unset in production.
DASHBOARD_INSECURE_COOKIES=1

# ── bot only, both optional ──────────────────────────────────────────
# The server that owner-only /admin commands are registered to.
OWNER_GUILD_ID=
# Set to 0 to drop the presence intent, which disables /stats playing.
PRESENCE_INTENT=1
