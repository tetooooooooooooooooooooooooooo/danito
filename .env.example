# Copy to .env for local development. .env is gitignored; never commit real values.
# On Heroku these are config vars instead, and the real environment always wins over this file.

# ── shared by the bot and the dashboard ──────────────────────────────
BOT_TOKEN=
Database_Connection_String=

# ── dashboard only ───────────────────────────────────────────────────
# Both from the Discord Developer Portal, under OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match a redirect exactly as entered in the portal, including the scheme and port.
DISCORD_REDIRECT_URI=http://localhost:5000/callback

# Signs the session cookie. Any long random string; changing it logs everyone out.
DASHBOARD_SECRET_KEY=

# The name shown on the web pages. The bot's own name inside Discord comes from the
# application in the Developer Portal, so that one follows a rename without a deploy.
DASHBOARD_BRAND=Newt

# Session cookies are Secure-only by default, which a browser will not send over plain http.
# Set this to 1 for localhost, and leave it unset in production.
DASHBOARD_INSECURE_COOKIES=1

# The public address of this site, used only to build absolute urls for link previews.
# Left unset it is worked out from the request, which is right almost always; set it if
# the app sits behind something that rewrites the host.
SITE_URL=

# Where Discord sends somebody after they add the bot, which should be the /added page,
# for example https://your-app.herokuapp.com/added. It must ALSO be added under OAuth2
# redirects in the Discord Developer Portal, or Discord refuses the whole invite. Left
# unset the invite works exactly as before and just doesn't redirect anywhere.
INVITE_REDIRECT_URI=

# Where the terms and privacy policy live. They sit on their own static site so they stay
# up whether or not this app is, and the footer links them on every page. The defaults
# point at the published pages, so this only needs setting if you move them.
TERMS_URL=
PRIVACY_URL=

# The support server invite shown on /support. Left unset, the page says the server is
# being set up and points people at tickets instead of offering a dead link.
SUPPORT_INVITE=

# What Premium costs, shown on /premium. The currency is a prefix, so put whatever symbol
# goes in front of the number. The saving on the yearly plan is worked out from these two
# rather than written down, so changing one keeps the other honest.
PREMIUM_CURRENCY=$
PREMIUM_PRICE_MONTHLY=2.99
PREMIUM_PRICE_YEARLY=29.99

# Where the buy buttons go, one checkout link per plan. Left unset the page still shows the
# prices but says Premium isn't open yet, rather than offering a button that leads nowhere.
# Nothing in this app takes a payment itself; these point at whoever does.
PREMIUM_CHECKOUT_MONTHLY=
PREMIUM_CHECKOUT_YEARLY=

# ── bot only, all optional ───────────────────────────────────────────
# Where new support tickets get posted. Without it the bot records them but announces
# nothing, and you would only find them with /tickets list.
SUPPORT_CHANNEL_ID=
# The server that owner-only /admin commands are registered to.
OWNER_GUILD_ID=
# Where the bot posts its own crashes: unhandled errors in commands, in event handlers, and
# any cog that wouldn't load. Left unset they only reach the process log, which is how it
# behaved before. Anybody who can read that channel can read the tracebacks, which carry ids
# and sometimes message content, so put it somewhere only staff can see.
ERROR_CHANNEL_ID=
# The guild that channel has to be in, as a guard against a mistyped id posting tracebacks
# into somebody else's server. Falls back to OWNER_GUILD_ID. Clear both to switch the check
# off, which is only sensible if the channel really is somewhere else.
ERROR_GUILD_ID=
# Set to 0 to drop the presence intent, which disables /stats playing.
PRESENCE_INTENT=1
# Where the dashboard lives. Only used to link to it in the message the bot posts when it is
# added to a server; the link is left out entirely when this is unset.
DASHBOARD_URL=
